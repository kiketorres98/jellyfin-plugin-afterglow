<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Afterglow</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Afterglow</AssemblyName>
    <AssemblyVersion>12.3.0.0</AssemblyVersion>
    <FileVersion>12.3.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Not shipped with the plugin: Jellyfin provides them at run time (leaving "runtime" in breaks plugin registration). -->
    <PackageReference Include="Jellyfin.Controller" Version="12.3.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.3.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The script and the settings page travel inside the DLL. -->
    <EmbeddedResource Include="Web\**\*" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
